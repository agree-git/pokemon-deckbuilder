extends "res://tests/test_merchant_ui.gd"
func escape() -> void:
    if native:
        print("OS_MOVE 20 100")
        await create_timer(0.15).timeout
        print("OS_KEY Escape")
        await create_timer(0.2).timeout
    else:
        var event := InputEventKey.new()
        event.keycode = KEY_ESCAPE
        event.pressed = true
        root.push_input(event)
        await process_frame
    settle()
    await process_frame
func run() -> void:
    DirAccess.make_dir_recursive_absolute("/tmp/pokemon-shop")
    root.mode = Window.MODE_WINDOWED
    root.size = Vector2i(1280,720)
    root.position = Vector2i.ZERO
    var j := TacticalJourney.new(2026,"field_kit",[1,4,7],true)
    j.phase = TacticalJourney.MAP
    j.step = 1
    j.enter_next()
    var session := root.get_node("BattleSession")
    session.set("profile",PlayerProfile.new("user://tests/upgrade_preview_collection.json"))
    session.set("save_store",JourneySave.new("user://tests/upgrade_preview_journey.json"))
    session.adopt_journey(j)
    ui = load("res://scenes/tactical_journey.tscn").instantiate()
    ui.journey = j
    root.add_child(ui)
    await process_frame
    settle()
    if native:
        print("OS_FOCUS ",DisplayServer.window_get_native_handle(DisplayServer.WINDOW_HANDLE))
        await create_timer(0.2).timeout
    var targets: Array[BattleCardInstance] = [j.deck[0],j.deck[2],j.deck[6]]
    var sizes := [Vector2i(1280,720),Vector2i(1024,768),Vector2i(1280,800)]
    for i in targets.size():
        # Each size starts at a fresh unused camp action; mutations below use UI.
        if i > 0:
            j.leave_camp()
            j.phase = TacticalJourney.MAP
            j.step = 1+i*2
            j.enter_next()
            ui.refresh()
        root.size = sizes[i]
        root.position = Vector2i.ZERO
        await process_frame
        settle()
        var target := targets[i]
        await click(ui.page.find_child("Upgrade",true,false))
        var button: Button = ui.page.find_child("Card_%d" % target.uid,true,false)
        var scroll := button.get_parent().get_parent() as ScrollContainer
        scroll.ensure_control_visible(button)
        await process_frame
        var before := JourneySnapshot.encode(j)
        await click(button)
        check(ui.upgrade_preview_uid == target.uid and ui.deck_open and JourneySnapshot.encode(j) == before,"Opening an upgrade preview spends no action, gold, HP or RNG")
        var original: TrainerActionCard = ui.page.find_child("UpgradeBefore",true,false)
        var improved: TrainerActionCard = ui.page.find_child("UpgradeAfter",true,false)
        check(original != null and improved != null and original.definition["name"] == TacticalContent.definition(target)["name"],"Both versions show actual card faces")
        var copy := BattleCardInstance.new(target.uid,target.key,target.owner_uid)
        copy.upgraded = true
        var expected := TacticalContent.definition(copy)
        check(improved.definition["description"] == expected["description"] and improved.definition["cost"] == expected["cost"] and not target.upgraded,"Preview is generated by the real upgrade rules without modifying the card")
        if target.owner_uid != 0: check(improved.definition["species_id"] == 1 and improved.definition["owner_name"] == "이상해씨","Technique preview keeps owner name and sprite")
        await click(ui.rest_button)
        check(JourneySnapshot.encode(j) == before and ui.upgrade_preview_uid == target.uid,"Preview blocks clicks on rest underneath")
        if i == 0: await picture("upgrade-comparison")
        await click(ui.page.find_child("UpgradeCancel",true,false))
        check(ui.upgrade_preview_uid == 0 and ui.deck_open and JourneySnapshot.encode(j) == before,"Cancel returns to the card list and preserves resources")
        button = ui.page.find_child("Card_%d" % target.uid,true,false)
        scroll = button.get_parent().get_parent() as ScrollContainer
        scroll.ensure_control_visible(button)
        await process_frame
        await click(button)
        await escape()
        check(ui.upgrade_preview_uid == 0 and ui.deck_open and JourneySnapshot.encode(j) == before,"Escape closes only the comparison")
        button = ui.page.find_child("Card_%d" % target.uid,true,false)
        scroll = button.get_parent().get_parent() as ScrollContainer
        scroll.ensure_control_visible(button)
        await process_frame
        await click(button)
        await click(ui.page.find_child("UpgradeConfirm",true,false),[0.08,0.5,0.92][i])
        check(target.upgraded and not ui.deck_open and ui.upgrade_preview_uid == 0 and ui.rest_button.disabled,"Top/center/bottom confirmation upgrades exactly the selected instance and consumes the camp action")
        var loaded: TacticalJourney = session.get("save_store").load_journey()
        check(loaded != null and JourneySnapshot.encode(loaded) == JourneySnapshot.encode(j),"Confirmed upgrade autosaves exactly")
    check(j.statistics["counts"]["cards_upgraded"] == 3 and j.statistics["counts"]["rests"] == 0,"Three comparisons grant exactly three confirmed camp upgrades")
    print("UPGRADE_PREVIEW_UI native=",native,": ",checks," checks, ",failures," failures; ",clicks," pointer inputs")
    quit(0 if failures == 0 else 1)
