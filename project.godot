; Godot 4.7.2 — Kanto asset and effect preview, independent of battle rules.
config_version=5

[application]
config/name="포켓몬 원정대"
run/main_scene="res://scenes/battle_preview.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
BattleSession="*res://scripts/battle/battle_session.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.036, 0.055, 0.082, 1)
