; Godot 4.7.2 — native 1080p Pokemon deck-building expedition.
config_version=5

[application]
config/name="포켓몬 원정대"
config/version="0.28.4"
config/use_custom_user_dir=true
config/custom_user_dir_name="PokemonExpedition"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.03529412, 0.078431375, 0.11764706, 1)
boot_splash/image="res://assets/branding/boot_splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/icon="res://assets/branding/expedition.png"
config/windows_native_icon="res://assets/branding/expedition.ico"

[autoload]
SaveLocation="*res://scripts/persistence/save_location.gd"
Preferences="*res://scripts/preferences.gd"
GameAudio="*res://scripts/audio/game_audio.gd"
GameMusic="*res://scripts/audio/game_music.gd"
GameAmbience="*res://scripts/audio/game_ambience.gd"
GameCries="*res://scripts/audio/game_cries.gd"
BattleSession="*res://scripts/battle/battle_session.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
; A maximized native window avoids the editor embedded-game input transform.
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.036, 0.055, 0.082, 1)
