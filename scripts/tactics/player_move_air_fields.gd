    if acted and id in [798,861]:PlayerMoveFields.write(b)["terrain"]="";PlayerMoveFields.write(b)["left"]=0
    if acted and id==802 and foe.alive():b._damage(foe,foe.hp,true)
    var c:=PlayerMoveFields.write(b)
    if c["terrain"]=="grassy":
        for actor:BattlePokemon in [p,foe]:
            if not actor.alive() or not PlayerMoveAltitude.grounded(b,actor) or (actor.uid<0 and PlayerMoveTactics.read(b)["heal_block"].get(actor.uid,0)>=b.turn):continue
            var n:=mini(actor.max_hp-actor.hp,maxi(1,actor.max_hp/16));actor.hp+=n
            if n>0:b._record("heal",actor.display_name+" · 그래스필드",{"target":actor.uid,"amount":n})
