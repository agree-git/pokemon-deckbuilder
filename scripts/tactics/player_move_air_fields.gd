static func factor(b:TacticalBattle,p:BattlePokemon,target:BattlePokemon,v:Dictionary) -> float:
    if PlayerMoveFields.fixed(v):return 1.0
    var c:=PlayerMoveFields.read(b);var type_name:String=v["type"];var result:=1.0;var id:=int(v["move_id"])
    if id!=165:
        if PlayerMoveAltitude.grounded(b,p) and {"electric":"electric","grassy":"grass","psychic":"psychic"}.get(c["terrain"],"")==type_name:result*=1.3
        if PlayerMoveAltitude.grounded(b,target) and c["terrain"]=="misty" and type_name=="dragon":result*=0.5
        if PlayerMoveAltitude.grounded(b,target) and c["terrain"]=="grassy" and id in [89,222,523]:result*=0.5
        if (type_name=="electric" and c["mud"]>0) or (type_name=="fire" and c["water"]>0):result/=3.0
    var wall:String="screen" if v.get("damage_class")=="special" else "reflect"
    if id!=280 and PlayerMoveFields.native(b,target,wall)==0 and (c[PlayerMoveFields.side(target)][wall]>0 or c[PlayerMoveFields.side(target)]["veil"]>0):result*=0.5
    return result
static func raw_damage(b:TacticalBattle,p:BattlePokemon,target:BattlePokemon,v:Dictionary,bonus:int) -> int:
    var n:=PlayerMoveExchange.raw_damage(b,PlayerMoveFields.room_clone(b,p),PlayerMoveFields.room_clone(b,target),v,bonus)
    return maxi(1,floori(n*factor(b,p,target,v))) if n>0 else 0
