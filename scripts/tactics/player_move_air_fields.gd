        v["priority_blocked"]=true;v["failed"]=true;v["card_notes"].append("사이코필드가 접지 상대에 대한 선공 공격을 차단")
    if v.has("damage") and not PlayerMoveFields.read(b)["terrain"].is_empty():v["card_notes"].append("현재 필드: "+str(PlayerMoveFields.TITLES[PlayerMoveFields.read(b)["terrain"]]))
